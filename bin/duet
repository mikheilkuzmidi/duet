#!/usr/bin/env bash
# duet: the parts that are not conversation.
#
# The pipeline is driven by the skills. This exists for what a shell does better
# than a prompt: checking, configuring, and reporting state.

set -uo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export DUET_ROOT="$(cd "$HERE/.." && pwd)"

. "$DUET_ROOT/lib/duet-common.sh"
. "$DUET_ROOT/lib/duet-host.sh"
. "$DUET_ROOT/lib/duet-setup.sh"
. "$DUET_ROOT/lib/duet-preflight.sh"
. "$DUET_ROOT/lib/duet-models.sh"
. "$DUET_ROOT/lib/duet-run.sh"
. "$DUET_ROOT/lib/duet-ledger.sh"
. "$DUET_ROOT/lib/duet-preset.sh"
. "$DUET_ROOT/lib/duet-ask.sh"
. "$DUET_ROOT/lib/duet-detect.sh"
. "$DUET_ROOT/lib/duet-goal.sh"
. "$DUET_ROOT/lib/duet-progress.sh"
. "$DUET_ROOT/lib/duet-github.sh"
. "$DUET_ROOT/lib/duet-window.sh"

cmd="${1:-help}"; shift 2>/dev/null || true

case "$cmd" in

  doctor)
    duet_preflight || true
    duet_step "Models"
    cm="$(duet_claude_model)"
    case "$cm" in
      *"[1m]") duet_say "  claude: $cm at effort $(duet_claude_effort)  (1,000,000 context)" ;;
      *)       duet_say "  claude: $cm at effort $(duet_claude_effort)" ;;
    esac
    m="$(duet_codex_model)"
    duet_say "  codex : ${m:-<catalog unavailable>} at effort $(duet_codex_effort "$m")"
    duet_step "GitHub"
    duet_say "  $(duet_gh_capabilities 2>/dev/null || echo 'gh not installed')"
    duet_step "Limits"
    duet_say "  agents: claude $(duet_max_agents_for claude), codex $(duet_max_agents_for codex)"
    duet_rate_report
    duet_say "  Duet asks for no dollar budget. Codex exposes no price to the CLI,"
    duet_say "  so a ceiling counting only Claude would look complete and not be."
    duet_step "Progress"
    duet_say "  mode: $(duet_progress_mode)"
    if duet_window_enabled; then
      duet_window_precheck
      python3 -c "import websockets" 2>/dev/null \
        && duet_ok "websockets present (window injection available)" \
        || duet_warn "python websockets missing; window injection unavailable, headless still works"
    fi
    duet_step "Notes"
    duet_say "  Claude Code drives. Codex is the fact-finder, backend and test author."
    duet_say "  Codex CLI is required. The Codex desktop app cannot be driven this way."
    ;;

  setup)
    # Non-interactive on purpose: Duet's own Bash calls have no interactive
    # stdin, and a setup that hangs waiting for `read` is worse than none. The
    # duet-setup SKILL asks the questions, then calls this with the answers.
    case "${1:-}" in
      --show) duet_setup_report; exit 0 ;;
      --max)
        shift
        phrase=""
        [ "${1:-}" = "--confirm" ] && phrase="${2:-}"
        duet_setup_max "$phrase" || exit 1
        duet_setup_report; exit 0 ;;
    esac
    duet_setup_apply "$@" || exit 1
    duet_detect_show >/dev/null 2>&1 && duet_detect_save >/dev/null 2>&1
    duet_setup_report
    ;;

  delegate)
    # Delegation as a SUBCOMMAND, so the orchestrator never sources a shell
    # library. bin/duet has a bash shebang; the caller's shell is irrelevant.
    # This exists because the skills used to say "source lib/duet-delegate.sh",
    # which fails or hangs under zsh, the default shell on macOS and the one
    # Claude Code's Bash tool runs.
    . "$DUET_ROOT/lib/duet-delegate.sh"
    sub="${1:-}"; shift 2>/dev/null || true
    case "$sub" in
      codex)  duet_delegate_codex  "$@" ;;
      claude) duet_delegate_claude "$@" ;;
      *) duet_say "usage: duet delegate codex  <brief> <cwd> <out.jsonl>"
         duet_say "       duet delegate claude <brief> <task> <cwd> <out.json>"; exit 1 ;;
    esac
    ;;

  goal)
    # Work that must come back finished, rather than merely stopped.
    . "$DUET_ROOT/lib/duet-delegate.sh"
    sub="${1:-}"; shift 2>/dev/null || true
    case "$sub" in
      codex)  duet_work_codex  "$@"; rc=$? ;;
      claude) duet_work_claude "$@"; rc=$? ;;
      status) duet_rate_limits; exit 0 ;;
      *) duet_say "usage: duet goal codex  <objective> <cwd> <out.jsonl>"
         duet_say "       duet goal claude <objective> <cwd> <out.json> <gate>"
         duet_say "       duet goal status                 # real rate limits"; exit 1 ;;
    esac
    duet_say "  $(duet_goal_explain $rc)"
    exit $rc
    ;;

  context)
    # What a delegated agent is told about THIS run. Printing it is how you
    # check that a setting reached the agent rather than merely being stored.
    duet_context_block "${1:-}" "${2:-}"
    ;;

  questions)
    [ -z "${1:-}" ] && { duet_say "usage: duet questions <preset>"; exit 1; }
    duet_preset_questions "$1" | grep -v '^FIXED='
    ;;

  ask)
    case "${1:-}" in
      --begin)  shift; duet_ask_begin "$@" ;;
      --revise) shift; duet_ask_revise "$@" ;;
      --report) duet_ask_report ;;
      "")       duet_say "usage: duet ask <stage> <title>            count a question"
                duet_say "       duet ask --begin <preset> <total> [variable]"
                duet_say "       duet ask --revise <total> <why> [variable]"
                duet_say "       duet ask --report"; exit 1 ;;
      *)        duet_ask "$@" ;;
    esac
    ;;

  window)
    # Open a viewer on a run by hand. Useful when the window was closed, or when
    # progress.mode is not window but you want to watch this one.
    dir="${1:-$(duet_run_latest)}"
    [ -z "$dir" ] && { duet_say "usage: duet window [run-dir]"; exit 1; }
    stream="$(ls -1t "$dir"/phases/*/raw.jsonl 2>/dev/null | head -1)"
    [ -z "$stream" ] && stream="$(ls -1t "$dir"/*.jsonl 2>/dev/null | head -1)"
    [ -z "$stream" ] && duet_die "no stream found under $dir"
    duet_window_open "$stream" "$(basename "$dir")" "$dir" "$(duet_codex_model)"
    ;;

  detect)
    if [ "${1:-}" = "--save" ]; then shift; duet_detect_save "$@"; else duet_detect_show; fi
    ;;

  gate)
    # Resolve and optionally run a preset stage's gate, so a human can check the
    # same command the pipeline checks.
    [ -z "${1:-}" ] && { duet_say "usage: duet gate <preset> <stage-index> [--run]"; exit 1; }
    eval "$(duet_preset_stage "$1" "${2:-1}" 2>/dev/null)" || duet_die "no such stage"
    raw="$(python3 -c '
import json,sys
d=json.load(open(sys.argv[1])); i=int(sys.argv[2])
print(d["stages"][i-1].get("gate_cmd",""))' "$(duet_preset_file "$1")" "${2:-1}")"
    if [ -z "$raw" ]; then duet_say "  [$2] $DUET_STAGE_TITLE has no command gate (it is a human gate)"; exit 0; fi
    resolved="$(duet_gate_resolve "$raw")"; rc=$?
    duet_say "  [$2] $DUET_STAGE_TITLE"
    duet_say "      $resolved"
    [ $rc -ne 0 ] && duet_warn "some commands are not configured; run: duet detect --save"
    if [ "${3:-}" = "--run" ]; then
      ( eval "$resolved" ) && duet_ok "gate passes" || { duet_err "gate fails"; exit 1; }
    fi
    ;;

  config)
    key="${1:-}"; val="${2:-}"
    [ -z "$key" ] && { duet_say "usage: duet config <key> [value] [local|global]"; exit 1; }
    if [ -z "$val" ]; then
      printf '%s\n' "$(duet_cfg "$key" "<unset>")"
    else
      duet_cfg_set "$key" "$val" "${3:-global}"
      duet_ok "$key = $val"
      [ "$key" = "permissions.bypass" ] && [ "$val" = "true" ] && duet_fastmode_offer
    fi
    ;;

  presets)
    if [ -n "${1:-}" ]; then
      duet_step "$1"
      duet_preset_show "$1"
    else
      duet_step "Presets"
      duet_preset_list
      duet_say ""
      duet_say "  duet presets <name>   show its stages"
    fi
    ;;

  status)
    dir="$(duet_run_latest)"
    [ -z "$dir" ] && { duet_say "no runs yet"; exit 0; }
    preset="$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1])).get("preset",""))' "$dir/plan.json" 2>/dev/null)"
    at="$(duet_run_resume_point "$dir")"
    duet_step "run $(basename "$dir")${preset:+   preset $preset}"
    if [ -n "$preset" ]; then
      duet_preset_show "$preset" "$((at + 1))"
    else
      duet_say "  next phase: $at"
    fi
    duet_say ""
    duet_ledger_report "$dir"
    q="$(python3 -c 'import json,sys;print(len(json.load(open(sys.argv[1]))))' "$dir/questions.json" 2>/dev/null || echo 0)"
    [ "$q" != "0" ] && duet_say "  questions waiting: $q"
    if duet_run_stale "$dir"; then
      duet_warn "research is older than $(duet_cfg resume.researchMaxAgeHours 24)h; resume will re-run it"
    fi
    ;;

  runs)
    root="$(duet_run_root)"
    [ -d "$root" ] || { duet_say "no runs yet"; exit 0; }
    for d in "$root"/*/; do
      [ -d "$d" ] || continue
      id="$(basename "$d")"
      at="$(duet_run_resume_point "${d%/}")"
      printf '  %s  next phase: %s\n' "$id" "$at"
    done
    ;;

  version)
    printf 'duet %s\n' "$DUET_VERSION"
    # Non-blocking staleness check, cached, at most once a day. Duet's behaviour
    # lives in prompts, so a stale copy does not merely lack features: it
    # contradicts its own documentation.
    cache="${XDG_CACHE_HOME:-$HOME/.cache}/duet/latest"
    mkdir -p "$(dirname "$cache")"
    if [ ! -f "$cache" ] || [ -n "$(find "$cache" -mmin +1440 2>/dev/null)" ]; then
      (duet_has gh && gh api repos/mikheilkuzmidi/duet/releases/latest --jq .tag_name 2>/dev/null > "$cache") &
    fi
    latest="$(cat "$cache" 2>/dev/null | tr -d 'v[:space:]')"
    # Compare by ORDER, not inequality. The old test warned that 0.1.0 was
    # "newer" than 0.4.0, which is the kind of thing that teaches people to
    # ignore upgrade notices.
    newer=""
    if [ -n "$latest" ] && [ "$latest" != "$DUET_VERSION" ]; then
      newer="$(printf '%s\n%s\n' "$DUET_VERSION" "$latest" | sort -V | tail -1)"
    fi
    if [ -n "$newer" ] && [ "$newer" = "$latest" ]; then
      duet_warn "a newer Duet is available ($latest). Upgrade:"
      duet_say  "  codex plugin marketplace upgrade duet"
      duet_say  "  claude: /plugin marketplace update mikheilkuzmidi/duet"
    fi
    ;;

  help|*)
    cat <<'EOF'
duet: Claude leads, Codex checks the facts.

  duet doctor            both CLIs, auth, models, caps, rate limits
  duet setup [k=v ...]   configure this repo. --show to read it back
  duet setup --max       max allowance: wide open, for people who read diffs
  duet detect [--save]   this project's install, test, lint, deploy commands
  duet window [run-dir]  open a window watching an agent work
  duet questions <preset>  how many questions it asks, and where
  duet ask ...           count a question and print its header
  duet delegate ...      hand a brief to codex or claude
  duet goal ...          hand work over as a goal, which ends on a command
  duet context [stage]   what a delegated agent is told about this run
  duet gate <preset> <n> the command that decides whether stage n is done
  duet status            which stage the current run is on
  duet presets [name]    the fixed stage lists
  duet config <k> [v]    read or set one key (add "local" to scope to this repo)
  duet runs              every run in this project
  duet version           version, and whether this copy is stale

The pipeline is conversational. In Claude Code:

  /duet:duet-setup       set up this repo. Once.
  /duet:duet             any task, through both agents
  /duet:duet-app         build a new app from an idea
  /duet:duet-rescue      repair an app that exists and works badly
  /duet:duet-feature     add to a working project
  /duet:duet-skill       build a new skill
  /duet:duet-research    what is currently true. No code written
  /duet:duet-plan        show the plan, run nothing
  /duet:duet-build       run an approved plan
  /duet:duet-debate      both agents review existing work
  /duet:duet-resume      continue a run that stopped
  /duet:duet-status      where the run got to

In Codex, reach the same skills through /skills. Codex has no custom slash
commands, so onboarding is asymmetric and there is no way around that.

Keys worth knowing:
  voice                     plain, technical
  autonomy                  full, product, off
  safety.alwaysAsk          what I never do without asking
  safety.mode               ask-now, defer-to-final
  git.mode                  none, commit, branch, pr
  goal.maxMinutes           give up on a goal after this long, default 120
  grill.depth               off, normal, hard
  agents.claude.max         default 2
  agents.codex.max          default 2, ceiling 10 across both
  progress.mode             off, heartbeat, digest, window
  permissions.bypass        fast mode, default false. See README first
  budget.warnUsd            warn past this spend, default 5
  budget.stopUsd            hard stop, default 0 (off)
  done.coverageMin          coverage floor, default 80
  models.claude.model       default "best", a tier alias that tracks new models
  models.codex.model        default: highest priority in the runtime catalog
  resume.researchMaxAgeHours   re-run research on resume past this age, default 24
EOF
    ;;
esac
